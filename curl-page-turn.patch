+package eu.kanade.tachiyomi.ui.reader.viewer.pager
+
+import android.graphics.Bitmap
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.LinearGradient
+import android.graphics.Matrix
+import android.graphics.Paint
+import android.graphics.Path
+import android.graphics.Shader
+import android.view.View
+import kotlin.math.PI
+import kotlin.math.abs
+import kotlin.math.cos
+import kotlin.math.floor
+import kotlin.math.roundToInt
+import kotlin.math.sin
+
+/**
+ * 仿真翻页（纸张卷曲），照悠长漫影「仿真」档的纸面模型重写。
+ *
+ * 当前页沿一条倾斜折线卷成圆柱，卷过去的纸背翻到近侧悬在页面上方，折线远侧露出下一页。
+ * 分三块画：
+ *  1. 平铺段 d <= 0：原页，靠近折线压一道落影；
+ *  2. 卷柱段 0 < d <= PI*r：投影宽 r 的柱面，看到的是纸背，柱顶亮、折线处暗；
+ *  3. 翻折段 d > PI*r：纸背平铺在近侧，位置 = 关于折线镜像再沿法线推 PI*r，
+ *     叠 12% 透字，前缘压暗。
+ *
+ * d = p·n̂ - fold，n̂ 是折线法线（略上倾），fold 随进度从远角扫到近角。
+ * 全走 Canvas（Path + Matrix + 位图），不依赖 RenderEffect / AGSL，API 26 起可用。
+ */
+class PageCurl(
+    /** R2L（日漫右开）时整幅画面左右镜像。 */
+    private val mirrored: Boolean,
+) {
+    private val bitmapPaint = Paint(Paint.FILTER_BITMAP_FLAG or Paint.ANTI_ALIAS_FLAG)
+    private val fillPaint = Paint(Paint.ANTI_ALIAS_FLAG)
+    private val matrix = Matrix()
+    private val path = Path()
+
+    private var page: Bitmap? = null
+    private var pageView: View? = null
+    private var lastScrollX = -1
+    private var outLeft = 0
+    private var progress = 0f
+
+    /** 每帧画前调用：钉住进来那页、藏起翻走那页并截好图。返回是否可以画卷曲。 */
+    fun beforeDraw(pager: Pager): Boolean {
+        val w = pager.width
+        val h = pager.height
+        if (w <= 0 || h <= 0) return false
+
+        val sx = pager.scrollX
+        val f = sx.toFloat() / w
+        val base = floor(f).toInt()
+        val frac = f - base
+
+        if (frac < 0.0005f) {
+            restore(pager)
+            lastScrollX = sx
+            return false
+        }
+
+        val dir = if (lastScrollX < 0 || sx >= lastScrollX) 1 else -1
+        lastScrollX = sx
+        val outIndex = if (dir > 0) base else base + 1
+        val prog = if (dir > 0) frac else 1f - frac
+
+        var out: View? = null
+        var inc: View? = null
+        for (i in 0 until pager.childCount) {
+            val c = pager.getChildAt(i)
+            val idx = (c.left.toFloat() / w).roundToInt()
+            if (idx == outIndex) out = c
+            if (idx == outIndex + dir) inc = c
+        }
+        val outgoing = out ?: return false
+
+        inc?.let {
+            val tx = -(it.left - sx).toFloat()
+            if (abs(it.translationX - tx) > 0.5f) it.translationX = tx
+            if (it.alpha != 1f) it.alpha = 1f
+        }
+
+        if (pageView !== outgoing) {
+            capture(outgoing, w, h)
+            pageView = outgoing
+        }
+        if (outgoing.alpha != 0f) outgoing.alpha = 0f
+
+        outLeft = outgoing.left
+        progress = prog
+        return page != null
+    }
+
+    private fun restore(pager: Pager) {
+        for (i in 0 until pager.childCount) {
+            val c = pager.getChildAt(i)
+            if (c.translationX != 0f) c.translationX = 0f
+            if (c.alpha != 1f) c.alpha = 1f
+        }
+    }
+
+    private fun capture(view: View, w: Int, h: Int) {
+        val old = page
+        val bmp = if (old != null && old.width == w && old.height == h && !old.isRecycled) {
+            old
+        } else {
+            Bitmap.createBitmap(w, h, Bitmap.Config.ARGB_8888)
+        }
+        bmp.eraseColor(Color.TRANSPARENT)
+        view.draw(Canvas(bmp))
+        page = bmp
+    }
+
+    /** 在 pager 的 canvas 上把卷曲的纸画出来（子 View 之后调用）。 */
+    fun draw(canvas: Canvas, pager: Pager) {
+        val bmp = page ?: return
+        val w = pager.width.toFloat()
+        val h = pager.height.toFloat()
+        if (w <= 0f || h <= 0f) return
+
+        val save = canvas.save()
+        canvas.translate((pager.scrollX - outLeft).toFloat(), pager.scrollY.toFloat())
+        if (mirrored) canvas.scale(-1f, 1f, w / 2f, h / 2f)
+
+        val nx = cos(TILT)
+        val ny = -sin(TILT)
+        val r = (w * CURL_RADIUS_RATIO).coerceAtLeast(MIN_RADIUS)
+        val projMax = maxOf(0f, w * nx, h * ny, w * nx + h * ny)
+        val projMin = minOf(0f, w * nx, h * ny, w * nx + h * ny)
+        val fold = projMax - (projMax - projMin) * progress
+        val piR = PI.toFloat() * r
+        val rect = floatArrayOf(0f, 0f, w, 0f, w, h, 0f, h)
+
+        // ---- 1. 平铺段 ----
+        val flat = clip(rect, nx, ny, fold, keepLess = true)
+        if (flat != null) {
+            val s = canvas.save()
+            canvas.clipPath(toPath(flat))
+            canvas.drawBitmap(bmp, 0f, 0f, bitmapPaint)
+            fillPaint.shader = LinearGradient(
+                nx * fold, ny * fold,
+                nx * (fold - SHADOW_WIDTH * r), ny * (fold - SHADOW_WIDTH * r),
+                intArrayOf(0x90000000.toInt(), 0x00000000),
+                floatArrayOf(0f, 1f),
+                Shader.TileMode.CLAMP,
+            )
+            canvas.drawRect(0f, 0f, w, h, fillPaint)
+            fillPaint.shader = null
+            canvas.restoreToCount(s)
+        }
+
+        // ---- 2. 卷柱段 ----
+        val farSide = clip(rect, nx, ny, fold, keepLess = false)
+        val band = farSide?.let { clip(it, nx, ny, fold + r, keepLess = true) }
+        if (band != null) {
+            val s = canvas.save()
+            canvas.clipPath(toPath(band))
+            fillPaint.shader = null
+            fillPaint.color = PAPER
+            canvas.drawRect(0f, 0f, w, h, fillPaint)
+            fillPaint.shader = LinearGradient(
+                nx * fold, ny * fold,
+                nx * (fold + r), ny * (fold + r),
+                intArrayOf(0x66000000, 0x00000000, 0x22FFFFFF),
+                floatArrayOf(0f, 0.5f, 1f),
+                Shader.TileMode.CLAMP,
+            )
+            canvas.drawRect(0f, 0f, w, h, fillPaint)
+            fillPaint.shader = null
+            canvas.restoreToCount(s)
+        }
+
+        // ---- 3. 翻折段 ----
+        val far = clip(rect, nx, ny, fold + piR, keepLess = false)
+        if (far != null) {
+            val flap = FloatArray(far.size)
+            var i = 0
+            while (i + 1 < far.size) {
+                val x = far[i]
+                val y = far[i + 1]
+                val d = x * nx + y * ny - fold
+                val off = piR - 2f * d
+                flap[i] = x + nx * off
+                flap[i + 1] = y + ny * off
+                i += 2
+            }
+
+            val s = canvas.save()
+            canvas.clipPath(toPath(flap))
+            fillPaint.shader = null
+            fillPaint.color = PAPER
+            canvas.drawRect(0f, 0f, w, h, fillPaint)
+
+            // 纸背透字：关于折线镜像
+            matrix.setValues(
+                floatArrayOf(
+                    1f - 2f * nx * nx, -2f * nx * ny, nx * (2f * fold + piR),
+                    -2f * ny * nx, 1f - 2f * ny * ny, ny * (2f * fold + piR),
+                    0f, 0f, 1f,
+                ),
+            )
+            bitmapPaint.alpha = SHOW_THROUGH
+            canvas.drawBitmap(bmp, matrix, bitmapPaint)
+            bitmapPaint.alpha = 255
+
+            // 前缘压暗，纸背有点厚度
+            fillPaint.shader = LinearGradient(
+                nx * fold, ny * fold,
+                nx * (fold - piR), ny * (fold - piR),
+                intArrayOf(0x00000000, 0x33000000),
+                floatArrayOf(0f, 1f),
+                Shader.TileMode.CLAMP,
+            )
+            canvas.drawRect(0f, 0f, w, h, fillPaint)
+            fillPaint.shader = null
+            canvas.restoreToCount(s)
+        }
+
+        canvas.restoreToCount(save)
+    }
+
+    private fun toPath(poly: FloatArray): Path {
+        path.reset()
+        path.moveTo(poly[0], poly[1])
+        var i = 2
+        while (i + 1 < poly.size) {
+            path.lineTo(poly[i], poly[i + 1])
+            i += 2
+        }
+        path.close()
+        return path
+    }
+
+    /** 多边形按半平面 {p·n̂ <= c}（或 >=）裁剪，返回顶点序列。 */
+    private fun clip(src: FloatArray, nx: Float, ny: Float, c: Float, keepLess: Boolean): FloatArray? {
+        if (src.size < 6) return null
+        val out = FloatArray(src.size + 8)
+        var n = 0
+        val count = src.size / 2
+        val sign = if (keepLess) 1f else -1f
+        for (i in 0 until count) {
+            val ax = src[i * 2]
+            val ay = src[i * 2 + 1]
+            val j = (i + 1) % count
+            val bx = src[j * 2]
+            val by = src[j * 2 + 1]
+            val da = (ax * nx + ay * ny - c) * sign
+            val db = (bx * nx + by * ny - c) * sign
+            if (da <= 0f) {
+                out[n++] = ax
+                out[n++] = ay
+            }
+            if ((da < 0f && db > 0f) || (da > 0f && db < 0f)) {
+                val t = da / (da - db)
+                out[n++] = ax + (bx - ax) * t
+                out[n++] = ay + (by - ay) * t
+            }
+        }
+        if (n < 6) return null
+        return out.copyOf(n)
+    }
+
+    private companion object {
+        const val TILT = 0.20f
+        const val CURL_RADIUS_RATIO = 0.055f
+        const val MIN_RADIUS = 12f
+        const val SHADOW_WIDTH = 2.2f
+        const val SHOW_THROUGH = 30
+        const val PAPER = 0xFFFCFAF4.toInt()
+    }
+}
