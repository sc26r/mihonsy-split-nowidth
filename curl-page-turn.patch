+package eu.kanade.tachiyomi.ui.reader.viewer.pager
+
+import android.graphics.RenderEffect
+import android.graphics.RuntimeShader
+import android.os.Build
+import android.view.View
+import androidx.annotation.RequiresApi
+import androidx.viewpager.widget.ViewPager
+import kotlin.math.cos
+import kotlin.math.sin
+
+/**
+ * 仿真翻页（参考悠长漫影的「仿真」档）。
+ *
+ * 几何：把当前页当成一张纸，沿一条倾斜的折线卷成圆柱。折线右侧的纸包着柱子卷过去，
+ * 屏幕上看得到的是**纸背**（背面朝观众），柱顶之后纸背压回平铺面、在折线左侧压出一道
+ * 落影；折线左侧仍是原页。圆柱半圈投影宽度 = 半径 r，弧长 s = r·theta，
+ * theta = PI - asin(d / r)，所以卷过去的纸在屏幕上是被镜像压缩的。
+ *
+ * 着色照抄悠长漫影 fragment 里的口径：纸背 = 空白纸色混 12% 背面内容，
+ * 法线 n = (n̂·sin theta, -cos theta)，主光 (-0.35, 0.30, 0.88)，
+ * 漫反射 0.58 + 0.42·NdotL 再叠一道掠射高光。
+ *
+ * 实现走 RuntimeShader（AGSL，Android 13 / API 33 起）：ViewPager 只推进 position，
+ * 页面形变全部在 GPU 上逐像素重采样。着色器编译失败或系统低于 13 时本类不接管，
+ * 保持原生滑动，绝不让阅读器崩在打开阶段。
+ */
+@RequiresApi(Build.VERSION_CODES.TIRAMISU)
+class CurlPageTransformer(
+    /** R2L（日漫右开）时整幅画面左右镜像，折线改到左侧。 */
+    private val mirrored: Boolean,
+) : ViewPager.PageTransformer {
+
+    private val shader: RuntimeShader? = runCatching { RuntimeShader(CURL_AGSL) }.getOrNull()
+
+    override fun transformPage(page: View, position: Float) {
+        val s = shader ?: return
+        val width = page.width
+        if (width <= 0) return
+
+        // 抵消 ViewPager 的平移：纸面钉在屏幕原位，滚动只用来推进 position。
+        // |position| > 1 的页照常停在屏幕外，别让它们叠上来。
+        page.translationX = when {
+            position > 1f -> -width.toFloat()
+            position < -1f -> width.toFloat()
+            else -> -position * width
+        }
+
+        if (position < -1f || position > 1f) {
+            page.setRenderEffect(null)
+            return
+        }
+
+        val height = page.height
+        if (height <= 0) return
+
+        // u：镜像归一化后的位置。u < 0 = 正在被卷走的那页，u > 0 = 底下被揭开的那页。
+        val u = if (mirrored) -position else position
+        if (u > 0f) {
+            page.setRenderEffect(null)
+            return
+        }
+
+        val progress = (-u).coerceIn(0f, 1f)
+        if (progress < MIN_PROGRESS) {
+            page.setRenderEffect(null)
+            return
+        }
+
+        val w = width.toFloat()
+        val h = height.toFloat()
+        // 折线法线：向右、略向上倾斜，右上角先被掀起
+        val nx = cos(TILT)
+        val ny = -sin(TILT)
+        // 折线位置 = 全页投影区间的插值：progress 0 时在远角外（没卷），1 时扫到近角
+        val projMax = maxOf(0f, w * nx, h * ny, w * nx + h * ny)
+        val projMin = minOf(0f, w * nx, h * ny, w * nx + h * ny)
+        val fold = projMax - (projMax - projMin) * progress
+
+        s.setFloatUniform("uSize", w, h)
+        s.setFloatUniform("uN", nx, ny)
+        s.setFloatUniform("uFold", fold)
+        s.setFloatUniform("uRadius", (w * CURL_RADIUS_RATIO).coerceAtLeast(MIN_RADIUS_PX))
+        s.setFloatUniform("uMirror", if (mirrored) 1f else 0f)
+        page.setRenderEffect(RenderEffect.createRuntimeShaderEffect(s, CHILD_SHADER))
+    }
+
+    private companion object {
+        /** RenderEffect 里被子 shader 的名字，必须和 AGSL 的 uniform shader 同名。 */
+        const val CHILD_SHADER = "content"
+
+        /** 折线倾角（弧度）。0.20 ≈ 11.5°，右上角先卷。 */
+        const val TILT = 0.20f
+
+        /** 卷柱半径占页宽比例：0.11 ≈ 1080 宽时 119px。 */
+        const val CURL_RADIUS_RATIO = 0.11f
+        const val MIN_RADIUS_PX = 10f
+
+        /** 位置小于这个值就当没在卷，省掉一次离屏合成。 */
+        const val MIN_PROGRESS = 0.004f
+
+        const val CURL_AGSL = """
+            uniform shader content;
+            uniform float2 uSize;
+            uniform float2 uN;
+            uniform float uFold;
+            uniform float uRadius;
+            uniform float uMirror;
+
+            half4 main(float2 coord) {
+                float w = uSize.x;
+                float2 p = coord;
+                float2 n = uN;
+                if (uMirror > 0.5) {
+                    p.x = w - p.x;
+                    n.x = -n.x;
+                }
+
+                float r = max(uRadius, 1.0);
+                float d = dot(p, n) - uFold;
+
+                // 还没卷到的平铺部分：原样输出，贴折线处压一道卷起纸的落影
+                if (d < 0.0) {
+                    half4 c = content.eval(coord);
+                    float shade = 1.0 - 0.38 * exp(d / (r * 0.9));
+                    return half4(c.rgb * half(shade), c.a);
+                }
+
+                // 柱体之外：纸已经卷过去，让出底下那页
+                if (d > r) {
+                    return half4(0.0);
+                }
+
+                // 卷起的半圈：theta 从 PI（折线处，纸背正对镜头）到 PI/2（柱顶）
+                float theta = 3.14159265 - asin(clamp(d / r, -1.0, 1.0));
+                float s = r * theta;
+                float2 src = p + n * (s - d);
+                if (uMirror > 0.5) {
+                    src.x = w - src.x;
+                }
+
+                float3 paper = float3(0.985, 0.98, 0.963);
+                half4 back = half4(half3(paper), 1.0);
+                if (src.x >= 0.0 && src.x <= w && src.y >= 0.0 && src.y <= uSize.y) {
+                    half4 t = content.eval(src);
+                    back = half4(half3(mix(paper, float3(t.rgb), 0.12)), 1.0);
+                }
+
+                // 纸背法线：平面分量 n̂·sin(theta)，朝观众分量 -cos(theta)
+                float3 nb = float3(n.x * sin(theta), n.y * sin(theta), -cos(theta));
+                float3 L = normalize(float3(-0.35, 0.30, 0.88));
+                float ndl = max(0.0, dot(nb, L));
+                float lit = 0.58 + 0.42 * ndl;
+                lit += 0.10 * pow(ndl, 24.0);
+
+                return half4(back.rgb * half(lit), 1.0);
+            }
+        """
+    }
+}
